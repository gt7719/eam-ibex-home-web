{
  "name": "eam-ibex",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "build:vps": "bash scripts/build-vps.sh",
    "start": "bash scripts/start-vps.sh",
    "start:cloudflare": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:vps": "IBEX_RUNTIME=node node dist/standalone/server.js",
    "smoke:vps": "node scripts/smoke-vps.mjs",
    "test": "npm run build && node --experimental-loader ./scripts/cloudflare-loader.mjs --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "quality": "npm run lint && npm run typecheck && npm run test && npm run audit:prod",
    "quality:vps": "bash scripts/check-vps-release.sh",
    "baseline:v80": "bash scripts/check-v80-baseline.sh",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "db:generate:vps": "drizzle-kit generate --config=drizzle-postgres.config.ts",
    "db:migrate:vps": "node scripts/migrate-postgres.mjs",
    "data:import:d1": "node scripts/import-d1-to-postgres.mjs",
    "data:migrate:r2": "node scripts/migrate-r2-to-s3.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "drizzle-orm": "0.45.2",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "eAM iBeX"
}
