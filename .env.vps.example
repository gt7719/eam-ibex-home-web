# VPS runtime
NODE_ENV=production
IBEX_RUNTIME=node
HOST=0.0.0.0
PORT=3000
SHUTDOWN_TIMEOUT_MS=10000
VINEXT_TRUST_PROXY=1
VINEXT_TRUSTED_HOSTS=home.example.mn

# PostgreSQL
POSTGRES_DB=ibex
POSTGRES_USER=ibex
POSTGRES_PASSWORD=replace-me-with-a-long-random-secret
DATABASE_URL=postgresql://ibex:replace-me@postgres:5432/ibex
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000
PGSSL=disable
PGSSL_REJECT_UNAUTHORIZED=true

# MinIO / S3-compatible storage
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=ibex-media
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me-with-a-long-random-secret
S3_FORCE_PATH_STYLE=true

# Website identity protection (minimum 32 random characters)
HOME_AI_ID_HASH_SALT=replace-me-with-at-least-32-random-characters

# Home AI — optional until enabled in Admin
OPENAI_HOME_API_KEY=
CUSTOMER_AI_FAST_MODEL=gpt-5.6-luna
CUSTOMER_AI_COMPLEX_MODEL=gpt-5.6-terra
CUSTOMER_AI_MONTHLY_BUDGET_USD=
CUSTOMER_AI_MIN_FAIR_SHARE_USD=0.25
CUSTOMER_AI_REQUESTS_PER_MINUTE=6
CUSTOMER_AI_REQUESTS_PER_DAY=10
CUSTOMER_AI_MAX_OUTPUT_TOKENS=520

# Marketing AI — separate optional OpenAI project key
OPENAI_MARKETING_API_KEY=

# Industrial Intelligent AI — separate optional key
OPENAI_INTELLIGENT_API_KEY=

# Email verification — configure both key and sender before enabling policy
RESEND_API_KEY=
EMAIL_FROM=iBeX Account <no-reply@account.ibex.mn>
EMAIL_REPLY_TO=support@ibex.mn

# Turnstile — site and secret keys must be configured together
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMS verification connector — configure before enabling phone verification
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_SENDER=iBeX
